# ProofPath Mobile Environment Configuration Example
# Copy this file to .env.local to configure your local or LAN backend address:
#
# For Localhost (Desktop Browser):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
#
# For Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
# For Physical Phone on Local Wi-Fi (replace with your laptop's IPv4 address from ipconfig):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
